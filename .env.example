# Copy this file to .env and fill in real values. Never commit .env.
#   cp .env.example .env

# --- Database ---
DB_USERNAME=postgres
# Generate with: openssl rand -hex 24
DB_PASSWORD=change-me
DB_NAME=smartstock

# --- Backend ---
# Base64 encoded signing key for JWTs (at least 256 bits). Generate with: openssl rand -base64 48
JWT_SECRET_KEY=change-me
# Comma separated list of origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000
# "update" for local development, "validate" in production
DDL_AUTO=update
# Creates a demo/demo account on startup - keep false outside of demos
DEMO_USER_ENABLED=false
